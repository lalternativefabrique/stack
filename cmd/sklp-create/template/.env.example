# Skalpai observability — get these from app.skalpai.dev
SKALPAI_PROJECT_ID=
SKALPAI_API_KEY=
SKALPAI_ENDPOINT=http://localhost:4417

# Scaleway registry push (publish only)
SCW_SECRET_KEY=
SCW_ACCESS_KEY=

# Core
PORT=4100
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
NATS_URL=nats://localhost:4222

# Auth: urbangate is the suite's identity provider (Kratos holds the identity,
# Hydra issues the person's token). The web renders the screens and drives the
# flows; the core verifies the token. Declare the two clients in urbangate's
# ory/hydra/clients{,-dev}/ and paste their secrets here.
APP_URL=http://localhost:5273
URBANGATE_ISSUER_URL=http://localhost:4444
KRATOS_PUBLIC_URL=http://localhost:4433
URBANGATE_CLIENT_ID=__APP_NAME__-admin
URBANGATE_CLIENT_SECRET=
URBANGATE_PROVISIONER_CLIENT_ID=__APP_NAME__-provisioner
URBANGATE_PROVISIONER_CLIENT_SECRET=
# nakoda: VITE_NAKODA_SITE is the app's public site key (page views), and
# NAKODA_KEY its secret key (sign-ups), both from the app's page on nakoda.
# Unset, nothing is sent.
VITE_NAKODA_SITE=
NAKODA_KEY=
# What the core checks the token against (issuer + audience).
OIDC_ISSUER_URL=http://localhost:4444
OIDC_AUDIENCE=__APP_NAME__
APP_NAME=__APP_NAME__
# Where the web server proxies /api/core/* (the Go core). Defaults to :4100.
CORE_URL=http://localhost:4100
